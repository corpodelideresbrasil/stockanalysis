//@version=5
indicator("Market Physics Regime Model (MPRM)", overlay=true, max_labels_count=500)

// ==========================================
// 1. Inputs
// ==========================================
lookback_c     = input.int(20, "Coherence Lookback (n)", minval=2)
lookback_std   = input.int(20, "Volatility Lookback (σ)", minval=2)
lookback_norm  = input.int(100, "Normalization Lookback", minval=10)
tau            = input.int(10, "Inertia EMA Period (τ)", minval=1)
show_background = input.bool(true, "Show Background Colors")
show_labels     = input.bool(true, "Show Regime Labels")
use_softmax     = input.bool(false, "Use Softmax Probabilities for Decision")

// ==========================================
// 2. Fundamental Physics Variables
// ==========================================
// v_t = P_t - P_{t-1}
v = close - close[1]

// a_t = v_t - v_{t-1}
a = v - v[1]

// j_t = a_t - a_{t-1}
j = a - a[1]

// ==========================================
// 3. Energy and Momentum
// ==========================================
// E_k(t) = v_t^2 (Kinetic Energy)
ek = math.pow(v, 2)

// M_t = σ(P_t, n) · |v_t| (Momentum)
volatility = ta.stdev(close, lookback_std)
m = volatility * math.abs(v)

// I_t = EMA(M_t, τ) (Inertia)
i_inertia = ta.ema(m, tau)

// ==========================================
// 4. Coherence
// ==========================================
// C_t = |ρ(P_t, t)| (Structural Coherence)
// Correlation between price and time (bar_index)
c_coherence = math.abs(ta.correlation(close, bar_index, lookback_c))

// Φ_t = C_t · (E_k(t) + I_t) (Dynamic Structure)
phi = c_coherence * (ek + i_inertia)

// Dissipation: Energy not captured by structural coherence
dissipation = (1 - c_coherence) * (ek + i_inertia)
e_total = ek + i_inertia + dissipation

// ==========================================
// 5. Normalization and Sigmoid
// ==========================================
// Standard sigmoid function
sigmoid(x) => 1 / (1 + math.exp(-x))

// Standardize and Sigmoid (to map values to 0-1 range based on recent history)
norm_sigmoid(src, len) =>
    mean = ta.sma(src, len)
    stdev = ta.stdev(src, len)
    z = (src - mean) / math.max(stdev, 1e-10)
    sigmoid(z)

// ==========================================
// 6. Regime Fields
// ==========================================

// 6.1 Field: TREND
// R_trend(t) = σ((Φ_t - μ_Φ) / σ_Φ)
r_trend = norm_sigmoid(phi, lookback_norm)

// 6.2 Field: COMPRESSION
// R_comp(t) = σ(f(low volatility, C_t))
// We'll define low volatility as a normalized inverse of volatility * coherence
// High coherence + low volatility = Compression
inv_vol = 1 / math.max(volatility, 1e-10)
r_comp = norm_sigmoid(inv_vol * c_coherence, lookback_norm)

// 6.3 Field: EXHAUSTION
// R_exh(t) = σ((|a_t| + |j_t|) · C_t)
exh_raw = (math.abs(a) + math.abs(j)) * c_coherence
r_exh = norm_sigmoid(exh_raw, lookback_norm)

// 6.4 Field: CHAOS
// R_chaos(t) = σ((σ(v_t) + |j_t|)(1 - C_t))
v_std = ta.stdev(v, lookback_std)
chaos_raw = (v_std + math.abs(j)) * (1 - c_coherence)
r_chaos = norm_sigmoid(chaos_raw, lookback_norm)

// ==========================================
// 7. Decision Logic
// ==========================================

// Softmax extension
exp_sum = math.exp(r_trend) + math.exp(r_comp) + math.exp(r_exh) + math.exp(r_chaos)
p_trend = math.exp(r_trend) / exp_sum
p_comp  = math.exp(r_comp) / exp_sum
p_exh   = math.exp(r_exh) / exp_sum
p_chaos = math.exp(r_chaos) / exp_sum

float max_val = 0.0
int regime = 0 // 0: Trend, 1: Compression, 2: Exhaustion, 3: Chaos

if use_softmax
    max_val := math.max(p_trend, p_comp, p_exh, p_chaos)
    if max_val == p_trend
        regime := 0
    else if max_val == p_comp
        regime := 1
    else if max_val == p_exh
        regime := 2
    else
        regime := 3
else
    max_val := math.max(r_trend, r_comp, r_exh, r_chaos)
    if max_val == r_trend
        regime := 0
    else if max_val == r_comp
        regime := 1
    else if max_val == r_exh
        regime := 2
    else
        regime := 3

// ==========================================
// 8. Visuals
// ==========================================
color regime_color = regime == 0 ? color.new(color.green, 85) :
                     regime == 1 ? color.new(color.blue, 85) :
                     regime == 2 ? color.new(color.orange, 85) :
                     color.new(color.red, 85)

bgcolor(show_background ? regime_color : na)

// Label for current status
var table info_table = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(info_table, 0, 0, "Regime", text_color = color.white)
    table.cell(info_table, 1, 0, regime == 0 ? "TREND" : regime == 1 ? "COMPRESSION" : regime == 2 ? "EXHAUSTION" : "CHAOS", text_color = color.white)

    table.cell(info_table, 0, 1, use_softmax ? "P_Trend" : "R_Trend", text_color = color.white)
    table.cell(info_table, 1, 1, str.tostring(use_softmax ? p_trend : r_trend, "#.##"), text_color = color.white)

    table.cell(info_table, 0, 2, use_softmax ? "P_Comp" : "R_Comp", text_color = color.white)
    table.cell(info_table, 1, 2, str.tostring(use_softmax ? p_comp : r_comp, "#.##"), text_color = color.white)

    table.cell(info_table, 0, 3, use_softmax ? "P_Exh" : "R_Exh", text_color = color.white)
    table.cell(info_table, 1, 3, str.tostring(use_softmax ? p_exh : r_exh, "#.##"), text_color = color.white)

    table.cell(info_table, 0, 4, use_softmax ? "P_Chaos" : "R_Chaos", text_color = color.white)
    table.cell(info_table, 1, 4, str.tostring(use_softmax ? p_chaos : r_chaos, "#.##"), text_color = color.white)

    table.cell(info_table, 0, 5, "Coherence", text_color = color.white)
    table.cell(info_table, 1, 5, str.tostring(c_coherence, "#.##"), text_color = color.white)

// Bar coloring
barcolor(regime == 0 ? color.green : regime == 1 ? color.blue : regime == 2 ? color.orange : color.red)

// 8.1 Arrows for regime transitions
plotshape(regime == 0 and regime[1] != 0, title="Enter Trend", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="TREND")
plotshape(regime == 2 and regime[1] != 2, title="Exhaustion", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="EXH")

// Alerts (optional but useful)
alertcondition(regime != regime[1], "Regime Change", "MPRM Regime changed")
alertcondition(regime == 0 and regime[1] != 0, "Trend Started", "Market entered Trend regime")
alertcondition(regime == 2 and regime[1] != 2, "Exhaustion Started", "Market entered Exhaustion regime")
