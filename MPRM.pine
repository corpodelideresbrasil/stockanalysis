//@version=5
indicator("Market Physics Regime Model V2 (MPRM System)", overlay=true, max_labels_count=500)

// ==========================================
// 1. Inputs
// ==========================================
lookback_c      = input.int(20, "Coherence Lookback", minval=2)
lookback_std    = input.int(20, "Volatility Lookback", minval=2)
lookback_norm   = input.int(100, "Normalization Lookback", minval=10)
tau             = input.int(10, "Inertia EMA Period (τ)", minval=1)
stability_thr   = input.float(0.4, "Stability Threshold (0-1)", minval=0.1, maxval=1.0, step=0.05, tooltip="Minimum probability/score to switch regime")
hysteresis      = input.float(0.1, "Trend Hysteresis", minval=0.0, maxval=0.5, step=0.05, tooltip="Extra score needed to exit Trend regime")
table_transp    = input.int(40, "Table Transparency", minval=0, maxval=100)
use_softmax     = input.bool(true, "Use Softmax Probabilities for Decision")

// ==========================================
// 2. Fundamental Physics & Projected Vector
// ==========================================
// v_t: velocity (displacement)
v = close - close[1]

// a_t: acceleration
a = v - v[1]

// j_t: jerk
j = a - a[1]

// Projected Velocity (Newtonian approximation)
v_proj = v + a

// Efficiency (η) = Displacement / Total Path
path = math.sum(math.abs(v), lookback_c)
displacement = math.abs(close - close[lookback_c])
efficiency = displacement / math.max(path, 1e-10)

// ==========================================
// 3. Energy Metrics
// ==========================================
ek = math.pow(v, 2)
volatility = ta.stdev(close, lookback_std)
m = volatility * math.abs(v)
inertia = ta.ema(m, tau)
coherence = math.abs(ta.correlation(close, bar_index, lookback_c))
phi = coherence * (ek + inertia)
ep = ta.ema(1 / math.max(volatility, 1e-10) * coherence, tau)

// ==========================================
// 4. Normalization (Z-Score / Logits)
// ==========================================
get_z(src, len) =>
    mean = ta.sma(src, len)
    stdev = ta.stdev(src, len)
    (src - mean) / math.max(stdev, 1e-10)

sigmoid(x) => 1 / (1 + math.exp(-x))

get_name(r) =>
    r == 0 ? "TREND" : r == 1 ? "COMP" : r == 2 ? "EXH" : "CHAOS"

// ==========================================
// 5. Regime Fields (Raw Z-Scores)
// ==========================================
f_confirm = (v > 0 and a > 0) or (v < 0 and a < 0) ? 1.0 : -0.5
z_trend = get_z(phi * efficiency * f_confirm, lookback_norm)

z_comp = get_z(ep * (1 - efficiency), lookback_norm)

// Exhaustion: High instability (jerk/accel) OR extreme divergence
exh_raw = (math.abs(j) / math.max(math.abs(a), 1e-10)) * coherence
z_exh_base = get_z(exh_raw, lookback_norm)

chaos_raw = (1 - coherence) * (1 - efficiency) * (ta.stdev(v, lookback_std))
z_chaos = get_z(chaos_raw, lookback_norm)

// ==========================================
// 6. Decision Logic
// ==========================================
// Pre-calculate risk to inject into scores
phi_ma = ta.sma(phi, 5)
eff_ma = ta.sma(efficiency, 5)
price_high = ta.highest(close, lookback_c)
price_low  = ta.lowest(close, lookback_c)
bool divergence_top = (close >= price_high) and (phi_ma < ta.highest(phi_ma, lookback_c)[1] or eff_ma < ta.highest(eff_ma, lookback_c)[1])
bool divergence_bot = (close <= price_low) and (phi_ma < ta.highest(phi_ma, lookback_c)[1] or eff_ma < ta.highest(eff_ma, lookback_c)[1])
bool phys_exh = (close >= price_high and v > 0 and a < 0) or (close <= price_low and v < 0 and a > 0)

// Inject risk into Exhaustion Z-score
z_exh = z_exh_base + (divergence_top or divergence_bot ? 1.0 : 0.0) + (phys_exh ? 0.5 : 0.0)

float score_trend = 0.0, float score_comp = 0.0, float score_exh = 0.0, float score_chaos = 0.0

if use_softmax
    // Softmax trick: subtract max to avoid overflow
    max_z = math.max(z_trend, z_comp, z_exh, z_chaos)
    e_trend = math.exp(z_trend - max_z)
    e_comp  = math.exp(z_comp - max_z)
    e_exh   = math.exp(z_exh - max_z)
    e_chaos = math.exp(z_chaos - max_z)
    exp_sum = e_trend + e_comp + e_exh + e_chaos

    score_trend := e_trend / exp_sum
    score_comp  := e_comp / exp_sum
    score_exh   := e_exh / exp_sum
    score_chaos := e_chaos / exp_sum
else
    score_trend := sigmoid(z_trend), score_comp := sigmoid(z_comp), score_exh := sigmoid(z_exh), score_chaos := sigmoid(z_chaos)

float max_score = math.max(score_trend, score_comp, score_exh, score_chaos)
int raw_regime = 0
if max_score == score_trend
    raw_regime := 0
else if max_score == score_comp
    raw_regime := 1
else if max_score == score_exh
    raw_regime := 2
else
    raw_regime := 3

var int regime = 3
// Hysteresis logic: if we are in trend (0), we need the max_score of the NEW regime
// to be higher than the current trend score plus hysteresis to exit.
// EXCEPT if the new regime is EXHAUSTION (2) and risk is high.
is_high_risk_exh = raw_regime == 2 and (z_exh > 1.5 or divergence_top or divergence_bot)
exit_trend_gate = (regime == 0 and raw_regime != 0 and not is_high_risk_exh) ? (max_score > score_trend + hysteresis) : true

if max_score > stability_thr and exit_trend_gate
    regime := raw_regime

// ==========================================
// 7. Anticipatory Warnings
// ==========================================
bool warn_decel = (regime == 0 or regime == 2) and ((v > 0 and a < 0) or (v < 0 and a > 0))
bool risk_reversal = (regime == 0 or regime == 2) and (z_exh > 1.2 or (warn_decel and z_exh > 0) or divergence_top or divergence_bot or phys_exh)
bool breakout_potential = (regime == 1 or regime == 3) and efficiency > 0.6 and phi > ta.sma(phi, lookback_norm)

// ==========================================
// 8. Visual System
// ==========================================
color c_trend = color.new(color.green, 85)
color c_comp  = color.new(color.blue, 85)
color c_exh   = color.new(color.orange, 85)
color c_chaos = color.new(color.purple, 85)

color regime_color = regime == 0 ? c_trend :
                     regime == 1 ? c_comp :
                     regime == 2 ? c_exh :
                     c_chaos

bgcolor(regime_color)
barcolor(regime == 0 ? color.green : regime == 1 ? color.blue : regime == 2 ? color.orange : regime == 3 ? color.purple : color.gray)

// Markov Transitions Tracking
var float[] transitions = array.new_float(16, 0.0) // 4x4 matrix
if bar_index > 0
    // index = last_regime * 4 + current_regime
    // We track EVERY transition, including staying in the same regime
    idx = regime[1] * 4 + regime
    array.set(transitions, idx, array.get(transitions, idx) + 1)

// Dashboard
var table info_table = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, table_transp), border_width = 1, border_color = color.gray)
if barstate.islast
    table.cell(info_table, 0, 0, "Regime", text_color = color.white)
    table.cell(info_table, 1, 0, regime == 0 ? "TREND" : regime == 1 ? "COMPRESSION" : regime == 2 ? "EXHAUSTION" : "CHAOS", text_color = color.white, bgcolor = regime_color)

    label_type = use_softmax ? "P(" : "S("
    table.cell(info_table, 0, 1, label_type + "Trend)", text_color = color.white)
    table.cell(info_table, 1, 1, str.tostring(score_trend * 100, "##.#") + "%", text_color = score_trend > stability_thr ? color.green : color.white)

    table.cell(info_table, 0, 2, label_type + "Comp)", text_color = color.white)
    table.cell(info_table, 1, 2, str.tostring(score_comp * 100, "##.#") + "%", text_color = score_comp > stability_thr ? color.blue : color.white)

    table.cell(info_table, 0, 3, label_type + "Exh)", text_color = color.white)
    table.cell(info_table, 1, 3, str.tostring(score_exh * 100, "##.#") + "%", text_color = score_exh > stability_thr ? color.orange : color.white)

    table.cell(info_table, 0, 4, label_type + "Chaos)", text_color = color.white)
    table.cell(info_table, 1, 4, str.tostring(score_chaos * 100, "##.#") + "%", text_color = score_chaos > stability_thr ? color.purple : color.white)

    table.cell(info_table, 0, 5, "Efficiency (η)", text_color = color.white)
    table.cell(info_table, 1, 5, str.tostring(efficiency, "#.##"), text_color = color.white)

    table.cell(info_table, 0, 6, "Proj. Move", text_color = color.white)
    table.cell(info_table, 1, 6, str.tostring(v_proj, "#.####"), text_color = v_proj > 0 ? color.green : color.red)

    // Simplified Markov Matrix Preview
    table.cell(info_table, 0, 7, "Markov T-1", text_color = color.gray, text_size = size.small)
    table.cell(info_table, 1, 7, "Next Prob", text_color = color.gray, text_size = size.small)

    // Calculate probabilities for the current state's transitions
    float s0 = array.get(transitions, regime * 4 + 0)
    float s1 = array.get(transitions, regime * 4 + 1)
    float s2 = array.get(transitions, regime * 4 + 2)
    float s3 = array.get(transitions, regime * 4 + 3)
    float total_t = math.max(s0 + s1 + s2 + s3, 1)

    table.cell(info_table, 0, 8, "Stay " + (regime == 0 ? "Trend" : regime == 1 ? "Comp" : regime == 2 ? "Exh" : "Chaos"), text_color = color.white, text_size = size.small)
    table.cell(info_table, 1, 8, str.tostring((array.get(transitions, regime * 4 + regime) / total_t) * 100, "##") + "%", text_color = color.white, text_size = size.small)

    // Find two most likely next regimes (excluding staying in current)
    float t0 = (regime == 0) ? -1 : s0
    float t1 = (regime == 1) ? -1 : s1
    float t2 = (regime == 2) ? -1 : s2
    float t3 = (regime == 3) ? -1 : s3

    float max1 = math.max(t0, t1, t2, t3)
    int r1 = t0 == max1 ? 0 : t1 == max1 ? 1 : t2 == max1 ? 2 : 3

    float t0_2 = (r1 == 0 or regime == 0) ? -1 : s0
    float t1_2 = (r1 == 1 or regime == 1) ? -1 : s1
    float t2_2 = (r1 == 2 or regime == 2) ? -1 : s2
    float t3_2 = (r1 == 3 or regime == 3) ? -1 : s3

    float max2 = math.max(t0_2, t1_2, t2_2, t3_2)
    int r2 = t0_2 == max2 ? 0 : t1_2 == max2 ? 1 : t2_2 == max2 ? 2 : 3

    table.cell(info_table, 0, 9, "Next Likely #1", text_color = color.white, text_size = size.small)
    table.cell(info_table, 1, 9, get_name(r1) + " (" + str.tostring((array.get(transitions, regime * 4 + r1) / total_t) * 100, "##") + "%)", text_color = color.yellow, text_size = size.small)

    table.cell(info_table, 0, 10, "Next Likely #2", text_color = color.white, text_size = size.small)
    table.cell(info_table, 1, 10, get_name(r2) + " (" + str.tostring((array.get(transitions, regime * 4 + r2) / total_t) * 100, "##") + "%)", text_color = color.gray, text_size = size.small)


// Signals
plotshape(regime == 0 and regime[1] != 0, title="Enter Trend", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="TREND")
plotshape(regime == 2 and regime[1] != 2, title="Exhaustion", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="EXH")
plotshape(regime == 3 and regime[1] != 3, title="Chaos", style=shape.xcross, location=location.abovebar, color=color.purple, size=size.tiny, text="CHAOS")
plotchar(warn_decel, title="Deceleration", char="!", location=location.abovebar, color=color.yellow, size=size.tiny)
plotchar(risk_reversal, title="Reversal Risk", char="‼", location=location.abovebar, color=color.red, size=size.small)
plotchar(divergence_top or divergence_bot, title="Energy Divergence", char="D", location=location.abovebar, color=color.fuchsia, size=size.tiny)
plotchar(breakout_potential, title="Breakout Potential", char="⊙", location=location.belowbar, color=color.aqua, size=size.tiny)

// Alerts
alertcondition(regime != regime[1], "Regime Change", "Regime shifted")
alertcondition(risk_reversal, "Reversal Risk!", "Model detects high reversal risk")
alertcondition(breakout_potential, "Breakout Potential", "Model detects accumulation/breakout setup")
