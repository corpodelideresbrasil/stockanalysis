//@version=5
indicator("Market Physics Regime Model V3.5 (MPRM System)", overlay=true, max_labels_count=500)

// ==========================================
// 1. Inputs & Asset Profiles
// ==========================================
lookback_c      = input.int(20, "Coherence Lookback", minval=2, group="Core Physics")
lookback_macro  = input.int(200, "Macro Lookback", minval=50, group="Core Physics")
lookback_std    = input.int(20, "Volatility Lookback", minval=2, group="Core Physics")
lookback_norm   = input.int(100, "Normalization Lookback", minval=10, group="Core Physics")
tau             = input.int(10, "Inertia EMA Period (τ)", minval=1, group="Core Physics")

asset_profile   = input.string("Equities/Standard", "Asset Physics Profile", options=["Crypto/Hyper-Vol", "Equities/Standard", "Indices/Heavy"], group="Decision Logic", tooltip="Adjusts internal physics constants for asset density")

stability_thr   = input.float(0.35, "Stability Threshold (0-1)", minval=0.1, maxval=1.0, step=0.05, group="Decision Logic")
hysteresis_base = input.float(0.08, "Base Trend Hysteresis", minval=0.0, maxval=0.5, step=0.01, group="Decision Logic")
energy_peak_thr = input.float(0.4, "Energy Peak Drop Thr", minval=0.1, maxval=0.9, step=0.05, group="Decision Logic")
risk_sens_base  = input.float(1.5, "Base Risk Sensitivity", minval=0.5, maxval=3.0, step=0.1, group="Decision Logic")
div_sens        = input.float(0.1, "Divergence Sensitivity", minval=0.0, maxval=0.5, step=0.05, group="Decision Logic")
breakout_thr    = input.float(0.6, "Breakout Efficiency Thr", minval=0.1, maxval=1.0, step=0.05, group="Decision Logic")
markov_stay_thr = input.float(0.6, "Markov Stay Persistence", minval=0.0, maxval=1.0, step=0.05, group="Decision Logic")

table_transp    = input.int(40, "Table Transparency", minval=0, maxval=100, group="Visuals")
use_phys_candles = input.bool(true, "Use Physics Candles", group="Visuals")
use_softmax     = input.bool(true, "Use Softmax Probabilities", group="Decision Logic")

// Dynamic Mapping of Profile Multipliers
float m_sens = asset_profile == "Crypto/Hyper-Vol" ? 1.4 : asset_profile == "Indices/Heavy" ? 0.75 : 1.0
float m_hyst = asset_profile == "Crypto/Hyper-Vol" ? 1.3 : asset_profile == "Indices/Heavy" ? 1.2 : 1.0
float m_norm = asset_profile == "Crypto/Hyper-Vol" ? 1.5 : asset_profile == "Indices/Heavy" ? 0.8 : 1.0

risk_sens  = risk_sens_base * m_sens
hysteresis = hysteresis_base * m_hyst
norm_len   = math.round(lookback_norm * m_norm)

// ==========================================
// 2. Fundamental Physics (Scale-Invariant)
// ==========================================
v = math.log(close / close[1])
a = v - v[1]
j = a - a[1]

path = math.sum(math.abs(v), lookback_c)
displacement = math.abs(math.sum(v, lookback_c))
efficiency = displacement / math.max(path, 1e-10)

ek = math.pow(v, 2)
vol_v = ta.stdev(v, lookback_std)

// Adaptive Volatility Benchmark (Market Heat)
benchmarking_vol = ta.ema(ta.stdev(v, 100), 200)
market_heat = vol_v / math.max(benchmarking_vol, 1e-10)

rel_vol = not na(volume) and volume > 0 ? (volume / ta.sma(volume, lookback_std)) : 1.0
mass = rel_vol * vol_v
p = mass * v
force = mass * a

inertia = ta.ema(mass * math.abs(v), tau)
coherence = math.abs(ta.correlation(close, bar_index, lookback_c))
phi = coherence * (ek + inertia)
ep = ta.ema(1 / math.max(vol_v, 1e-10) * coherence, tau)

// ==========================================
// 3. Normalization & Logits
// ==========================================
get_z(src, len) =>
    mean = ta.sma(src, len)
    stdev = ta.stdev(src, len)
    (src - mean) / math.max(stdev, 1e-10)

sigmoid(x) => 1 / (1 + math.exp(-x))
get_name(r) => r == 0 ? "BULL" : r == 1 ? "BEAR" : r == 2 ? "COMP" : r == 3 ? "EXH" : "CHAOS"

rho = ta.correlation(close, bar_index, lookback_c)
macro_rho = ta.correlation(close, bar_index, lookback_macro)

macro_guard_long  = macro_rho > 0.1 and close > ta.ema(close, lookback_c)
macro_guard_short = macro_rho < -0.1 and close < ta.ema(close, lookback_c)

f_accel_boost = (v > 0 and a > 0 and coherence > 0.8) or (v < 0 and a < 0 and coherence > 0.8) ? 1.2 : 1.0
f_confirm = (v > 0 and a > 0) or (v < 0 and a < 0) ? 1.1 * f_accel_boost : (math.abs(rho) > 0.8 ? 1.0 : 0.8)
trend_base = phi * math.sqrt(efficiency) * f_confirm

v_momentum = ta.ema(v, 3)
z_bull = get_z(rho > 0.05 ? (trend_base + inertia * 0.5 + v_momentum * 10) : -phi, norm_len) + (macro_rho > 0.3 ? 0.5 : 0)
z_bear = get_z(rho < -0.05 ? (trend_base + inertia * 0.5 - v_momentum * 10) : -phi, norm_len) + (macro_rho < -0.3 ? 0.5 : 0)

phi_dropping_local = phi < ta.ema(phi, 5)
z_comp = get_z(ep * (1 - efficiency) * (1 - math.abs(rho)) * (phi_dropping_local ? 1.2 : 0.5), norm_len)

price_high = ta.highest(close, lookback_c)
price_low  = ta.lowest(close, lookback_c)
dist_to_high = (price_high - close) / math.max(ta.stdev(close, lookback_c), 1e-10)
dist_to_low  = (close - price_low) / math.max(ta.stdev(close, lookback_c), 1e-10)
proximity_damping = math.exp(-math.min(dist_to_high, dist_to_low))

// Adaptive Exhaustion Logic (V3.5)
// Instead of simple Z, we dampen exhaustion if market heat is extreme (normal for crypto breakouts)
exh_raw = (math.abs(a) + math.abs(j)) * (1.0 - math.pow(coherence, 2)) * proximity_damping
z_exh_base = get_z(exh_raw, norm_len) / (market_heat > 2.0 ? math.sqrt(market_heat) : 1.0)

chaos_raw = (1 - coherence) * (1 - efficiency) * vol_v * 1.5
z_chaos = get_z(chaos_raw, norm_len)

// ==========================================
// 5. Decision Logic
// ==========================================
var int regime = 4
phi_ma = ta.sma(phi, 5)
eff_ma = ta.sma(efficiency, 5)

bool divergence_top = (close >= price_high) and (phi_ma < ta.highest(phi_ma, lookback_c)[1] * (1 - div_sens) or eff_ma < ta.highest(eff_ma, lookback_c)[1] * (1 - div_sens))
bool divergence_bot = (close <= price_low) and (phi_ma < ta.highest(phi_ma, lookback_c)[1] * (1 - div_sens) or eff_ma < ta.highest(eff_ma, lookback_c)[1] * (1 - div_sens))
bool phys_exh = (close >= price_high and v > 0 and a < 0) or (close <= price_low and v < 0 and a > 0)

z_exh := z_exh_base + (divergence_top or divergence_bot ? 1.0 : 0.0) + (phys_exh ? 0.5 : 0.0)

float s_bull = 0.0, float s_bear = 0.0, float s_comp = 0.0, float s_exh = 0.0, float s_chaos = 0.0
if use_softmax
    max_z = math.max(z_bull, z_bear, z_comp, z_exh, z_chaos)
    e_bull  = math.exp(z_bull - max_z)
    e_bear  = math.exp(z_bear - max_z)
    e_comp  = math.exp(z_comp - max_z)
    e_exh   = math.exp(z_exh - max_z)
    e_chaos = math.exp(z_chaos - max_z)
    exp_sum = e_bull + e_bear + e_comp + e_exh + e_chaos
    s_bull := e_bull / exp_sum, s_bear := e_bear / exp_sum, s_comp := e_comp / exp_sum, s_exh := e_exh / exp_sum, s_chaos := e_chaos / exp_sum
else
    s_bull := sigmoid(z_bull), s_bear := sigmoid(z_bear), s_comp := sigmoid(z_comp), s_exh := sigmoid(z_exh), s_chaos := sigmoid(z_chaos)

float max_s = math.max(s_bull, s_bear, s_comp, s_exh, s_chaos)
int raw_regime = max_s == s_bull ? 0 : max_s == s_bear ? 1 : max_s == s_comp ? 2 : max_s == s_exh ? 3 : 4

var float[] transitions = array.new_float(25, 0.0)
get_markov_stats(r_idx, trans_arr) =>
    s_t = 0.0
    for i = 0 to 4
        s_t += array.get(trans_arr, r_idx * 5 + i)
    s_t := math.max(s_t, 1.0)
    p_stay = array.get(trans_arr, r_idx * 5 + r_idx) / s_t
    [s_t, p_stay]

[sum_t_curr, stay_prob_curr] = get_markov_stats(nz(regime[1], 4), transitions)

is_trend = regime == 0 or regime == 1
current_trend_score = regime == 0 ? s_bull : s_bear
macro_bias_boost = (regime == 0 and macro_rho > 0.5) or (regime == 1 and macro_rho < -0.5) ? 0.05 : 0.0
stay_persistence = stay_prob_curr > markov_stay_thr ? 0.12 : 0.04

inertia_gate = is_trend and coherence > 0.7 and phi > inertia
exit_trend_gate = is_trend ? (raw_regime == regime or (max_s > current_trend_score + hysteresis + stay_persistence + macro_bias_boost and not inertia_gate)) : true

if max_s > stability_thr and exit_trend_gate
    regime := raw_regime

// ==========================================
// 6. Operational Signals
// ==========================================
var int trade_state = 0
bool cond_buy  = (regime == 0 and regime[1] != 0) or (regime == 0 and trade_state[1] == -1)
bool cond_sell = (regime == 1 and regime[1] != 1) or (regime == 1 and trade_state[1] == 1)

var float trade_peak_phi = 0.0
if trade_state[1] == 0 and (cond_buy or cond_sell)
    trade_peak_phi := phi
else if trade_state[1] != 0
    trade_peak_phi := math.max(trade_peak_phi, phi)
else
    trade_peak_phi := 0.0

fast_momentum_long  = v_momentum > 0.005 and close > ta.ema(close, 10)
fast_momentum_short = v_momentum < -0.005 and close < ta.ema(close, 10)

bool trend_is_dominant_long  = (rho > 0.4) and (s_bull > s_exh or v_momentum > 0 or macro_guard_long)
bool trend_is_dominant_short = (rho < -0.4) and (s_bear > s_exh or v_momentum < 0 or macro_guard_short)
bool trend_is_dominant = (trade_state[1] == 1 and trend_is_dominant_long) or (trade_state[1] == -1 and trend_is_dominant_short)

bool inertia_buffer_breached = phi < inertia
bool cond_energy_peak_exit = trade_state[1] != 0 and phi < trade_peak_phi * (1 - energy_peak_thr) and inertia_buffer_breached and not trend_is_dominant and (regime >= 2 or math.abs(rho) < 0.3)

bool cond_warn_decel = (regime <= 1 or regime == 3) and ((v > 0 and a < 0) or (v < 0 and a > 0))
bool cond_risk_reversal = (regime <= 1) and (z_exh > risk_sens and (cond_warn_decel or phys_exh or divergence_top or divergence_bot))
bool cond_breakout_setup = (regime == 2 or regime == 4) and efficiency > breakout_thr and phi > ta.sma(phi, lookback_norm)

bool flip_to_bear = trade_state[1] == 1 and rho < -0.3
bool flip_to_bull = trade_state[1] == -1 and rho > 0.3

bool structural_break_long  = (regime >= 2 and phi < ta.sma(phi, lookback_norm) * 0.8) and not macro_guard_long and not trend_is_dominant_long
bool structural_break_short = (regime >= 2 and phi < ta.sma(phi, lookback_norm) * 0.8) and not macro_guard_short and not trend_is_dominant_short

bool force_exh_exit_long  = regime == 3 and (divergence_top or close >= price_high) and not macro_guard_long and not trend_is_dominant_long
bool force_exh_exit_short = regime == 3 and (divergence_bot or close <= price_low) and not macro_guard_short and not trend_is_dominant_short

bool cond_exit_long  = (regime == 3 and not macro_guard_long and not trend_is_dominant_long) or (force_exh_exit_long and not trend_is_dominant_long) or (cond_risk_reversal and not trend_is_dominant_long) or flip_to_bear or structural_break_long or cond_energy_peak_exit
bool cond_exit_short = (regime == 3 and not macro_guard_short and not trend_is_dominant_short) or (force_exh_exit_short and not trend_is_dominant_short) or (cond_risk_reversal and not trend_is_dominant_short) or flip_to_bull or structural_break_short or cond_energy_peak_exit

bool buy_signal  = false
bool sell_signal = false
bool exit_long   = false
bool exit_short  = false

if trade_state == 1 and cond_exit_long
    trade_state := 0, exit_long := true
if trade_state == -1 and cond_exit_short
    trade_state := 0, exit_short := true
if trade_state == 0
    if cond_buy
        trade_state := 1, buy_signal := true
    else if cond_sell
        trade_state := -1, sell_signal := true

// ==========================================
// 7. Visual System
// ==========================================
color c_bull  = color.new(color.green, 85)
color c_bear  = color.new(color.red, 85)
color c_comp  = color.new(color.blue, 85)
color c_exh   = color.new(color.orange, 85)
color c_chaos = color.new(color.purple, 85)

color regime_color = regime == 0 ? c_bull : regime == 1 ? c_bear : regime == 2 ? c_comp : regime == 3 ? c_exh : c_chaos
bgcolor(regime_color)

color body_color = regime == 0 ? color.new(color.green, 30) : regime == 1 ? color.new(color.red, 30) : regime == 2 ? color.new(color.blue, 30) : regime == 3 ? color.new(color.orange, 30) : color.new(color.purple, 30)
color edge_color = v > 0 ? color.lime : color.maroon
plotcandle(use_phys_candles ? open : na, high, low, close, title="MPRM Candles", color=body_color, wickcolor=edge_color, bordercolor=edge_color)

var table info_table = table.new(position.top_right, 2, 14, bgcolor = color.new(color.black, table_transp), border_width = 1, border_color = color.gray)
if barstate.islast
    table.cell(info_table, 0, 0, "Regime (V3.5)", text_color = color.white)
    table.cell(info_table, 1, 0, get_name(regime) + " [" + asset_profile + "]", text_color = color.white, bgcolor = regime_color)
    pos_text = trade_state == 1 ? "LONG" : trade_state == -1 ? "SHORT" : "FLAT"
    table.cell(info_table, 0, 1, "Position", text_color = color.white)
    table.cell(info_table, 1, 1, pos_text, text_color = color.white, bgcolor = trade_state == 1 ? color.green : trade_state == -1 ? color.red : color.gray)
    table.cell(info_table, 0, 2, "Market Heat (RMS)", text_color = color.white)
    table.cell(info_table, 1, 2, str.tostring(market_heat, "#.##"), text_color = market_heat > 1.5 ? color.orange : color.lime)

plotshape(buy_signal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sell_signal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")
plotshape(exit_long, title="EXIT LONG", style=shape.xcross, location=location.abovebar, color=color.white, size=size.tiny, text="EXIT")
plotshape(exit_short, title="EXIT SHORT", style=shape.xcross, location=location.belowbar, color=color.white, size=size.tiny, text="EXIT")

if bar_index > 0
    idx_trans = regime[1] * 5 + regime
    array.set(transitions, idx_trans, array.get(transitions, idx_trans) + 1)
