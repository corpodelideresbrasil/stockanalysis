//@version=5
indicator("Market Physics Regime Model V2.1 (MPRM System)", overlay=true, max_labels_count=500)

// ==========================================
// 1. Inputs
// ==========================================
lookback_c      = input.int(20, "Coherence Lookback", minval=2, group="Core Physics")
lookback_std    = input.int(20, "Volatility Lookback", minval=2, group="Core Physics")
lookback_norm   = input.int(100, "Normalization Lookback", minval=10, group="Core Physics")
tau             = input.int(10, "Inertia EMA Period (τ)", minval=1, group="Core Physics")

stability_thr   = input.float(0.4, "Stability Threshold (0-1)", minval=0.1, maxval=1.0, step=0.05, group="Decision Logic", tooltip="Minimum probability/score to switch regime")
hysteresis      = input.float(0.1, "Trend Hysteresis", minval=0.0, maxval=0.5, step=0.05, group="Decision Logic", tooltip="Extra score needed to exit Trend regime")
risk_sens       = input.float(1.5, "Risk Warning Sensitivity", minval=0.5, maxval=3.0, step=0.1, group="Decision Logic", tooltip="Higher = less frequent warnings")
div_sens        = input.float(0.1, "Divergence Sensitivity", minval=0.0, maxval=0.5, step=0.05, group="Decision Logic", tooltip="Percentage drop in energy to trigger divergence")
breakout_thr    = input.float(0.6, "Breakout Efficiency Thr", minval=0.1, maxval=1.0, step=0.05, group="Decision Logic")

table_transp    = input.int(40, "Table Transparency", minval=0, maxval=100, group="Visuals")
use_softmax     = input.bool(true, "Use Softmax Probabilities", group="Decision Logic")

// ==========================================
// 2. Fundamental Physics
// ==========================================
v = close - close[1]
a = v - v[1]
j = a - a[1]

path = math.sum(math.abs(v), lookback_c)
displacement = math.abs(close - close[lookback_c])
efficiency = displacement / math.max(path, 1e-10)

ek = math.pow(v, 2)
volatility = ta.stdev(close, lookback_std)
m = volatility * math.abs(v)
inertia = ta.ema(m, tau)
coherence = math.abs(ta.correlation(close, bar_index, lookback_c))
phi = coherence * (ek + inertia)
ep = ta.ema(1 / math.max(volatility, 1e-10) * coherence, tau)

// ==========================================
// 3. Normalization & Logits
// ==========================================
get_z(src, len) =>
    mean = ta.sma(src, len)
    stdev = ta.stdev(src, len)
    (src - mean) / math.max(stdev, 1e-10)

sigmoid(x) => 1 / (1 + math.exp(-x))

get_name(r) =>
    r == 0 ? "BULL" : r == 1 ? "BEAR" : r == 2 ? "COMP" : r == 3 ? "EXH" : "CHAOS"

// ==========================================
// 4. Regime Fields (Bifurcated Trend)
// ==========================================
f_confirm = (v > 0 and a > 0) or (v < 0 and a < 0) ? 1.0 : -0.5
trend_base = phi * efficiency * f_confirm
z_bull = get_z(v > 0 ? trend_base : -phi, lookback_norm)
z_bear = get_z(v < 0 ? trend_base : -phi, lookback_norm)

z_comp = get_z(ep * (1 - efficiency), lookback_norm)

exh_raw = (math.abs(j) / math.max(math.abs(a), 1e-10)) * coherence
z_exh_base = get_z(exh_raw, lookback_norm)

chaos_raw = (1 - coherence) * (1 - efficiency) * (ta.stdev(v, lookback_std))
z_chaos = get_z(chaos_raw, lookback_norm)

// ==========================================
// 5. Decision Logic
// ==========================================
phi_ma = ta.sma(phi, 5)
eff_ma = ta.sma(efficiency, 5)
price_high = ta.highest(close, lookback_c)
price_low  = ta.lowest(close, lookback_c)

bool divergence_top = (close >= price_high) and (phi_ma < ta.highest(phi_ma, lookback_c)[1] * (1 - div_sens) or eff_ma < ta.highest(eff_ma, lookback_c)[1] * (1 - div_sens))
bool divergence_bot = (close <= price_low) and (phi_ma < ta.highest(phi_ma, lookback_c)[1] * (1 - div_sens) or eff_ma < ta.highest(eff_ma, lookback_c)[1] * (1 - div_sens))
bool phys_exh = (close >= price_high and v > 0 and a < 0) or (close <= price_low and v < 0 and a > 0)

// High-Risk Exh Injection
z_exh = z_exh_base + (divergence_top or divergence_bot ? 1.0 : 0.0) + (phys_exh ? 0.5 : 0.0)

float s_bull = 0.0, float s_bear = 0.0, float s_comp = 0.0, float s_exh = 0.0, float s_chaos = 0.0

if use_softmax
    max_z = math.max(z_bull, z_bear, z_comp, z_exh, z_chaos)
    e_bull  = math.exp(z_bull - max_z)
    e_bear  = math.exp(z_bear - max_z)
    e_comp  = math.exp(z_comp - max_z)
    e_exh   = math.exp(z_exh - max_z)
    e_chaos = math.exp(z_chaos - max_z)
    exp_sum = e_bull + e_bear + e_comp + e_exh + e_chaos

    s_bull  := e_bull / exp_sum
    s_bear  := e_bear / exp_sum
    s_comp  := e_comp / exp_sum
    s_exh   := e_exh / exp_sum
    s_chaos := e_chaos / exp_sum
else
    s_bull := sigmoid(z_bull), s_bear := sigmoid(z_bear), s_comp := sigmoid(z_comp), s_exh := sigmoid(z_exh), s_chaos := sigmoid(z_chaos)

float max_s = math.max(s_bull, s_bear, s_comp, s_exh, s_chaos)
int raw_regime = max_s == s_bull ? 0 : max_s == s_bear ? 1 : max_s == s_comp ? 2 : max_s == s_exh ? 3 : 4

var int regime = 4
// Hysteresis
is_trend = regime == 0 or regime == 1
current_trend_score = regime == 0 ? s_bull : s_bear
exit_trend_gate = (is_trend and raw_regime != regime) ? (max_s > current_trend_score + hysteresis) : true

if max_s > stability_thr and exit_trend_gate
    regime := raw_regime

// ==========================================
// 6. Operational Signals
// ==========================================
bool warn_decel = (regime <= 1 or regime == 3) and ((v > 0 and a < 0) or (v < 0 and a > 0))
// Use risk_sens to scale warnings
bool risk_reversal = (regime <= 1 or regime == 3) and (z_exh > risk_sens or (warn_decel and z_exh > risk_sens - 0.5) or divergence_top or divergence_bot or phys_exh)
bool breakout_setup = (regime == 2 or regime == 4) and efficiency > breakout_thr and phi > ta.sma(phi, lookback_norm)

// Explicit Operational Layer
bool buy_signal  = (regime == 0 and regime[1] != 0 and regime[1] != 3) // Enter Bull from anything except Exh
bool sell_signal = (regime == 1 and regime[1] != 1 and regime[1] != 3) // Enter Bear from anything except Exh
bool exit_long   = (regime[1] == 0) and (regime == 3 or risk_reversal or (regime == 1)) // Exit if Exh, Risk, or Trend Flip
bool exit_short  = (regime[1] == 1) and (regime == 3 or risk_reversal or (regime == 0)) // Exit if Exh, Risk, or Trend Flip

// ==========================================
// 7. Visual System
// ==========================================
color c_bull  = color.new(color.green, 85)
color c_bear  = color.new(color.red, 85)
color c_comp  = color.new(color.blue, 85)
color c_exh   = color.new(color.orange, 85)
color c_chaos = color.new(color.purple, 85)

color regime_color = regime == 0 ? c_bull : regime == 1 ? c_bear : regime == 2 ? c_comp : regime == 3 ? c_exh : c_chaos
bgcolor(regime_color)
barcolor(regime == 0 ? color.green : regime == 1 ? color.red : regime == 2 ? color.blue : regime == 3 ? color.orange : color.purple)

// Markov (5x5)
var float[] transitions = array.new_float(25, 0.0)
if bar_index > 0
    idx = regime[1] * 5 + regime
    array.set(transitions, idx, array.get(transitions, idx) + 1)

// Dashboard
var table info_table = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, table_transp), border_width = 1, border_color = color.gray)
if barstate.islast
    table.cell(info_table, 0, 0, "Regime", text_color = color.white)
    table.cell(info_table, 1, 0, get_name(regime), text_color = color.white, bgcolor = regime_color)

    label_type = use_softmax ? "P(" : "S("
    table.cell(info_table, 0, 1, label_type + "Bull)", text_color = color.white)
    table.cell(info_table, 1, 1, str.tostring(s_bull * 100, "##.#") + "%", text_color = s_bull > stability_thr ? color.green : color.white)
    table.cell(info_table, 0, 2, label_type + "Bear)", text_color = color.white)
    table.cell(info_table, 1, 2, str.tostring(s_bear * 100, "##.#") + "%", text_color = s_bear > stability_thr ? color.red : color.white)
    table.cell(info_table, 0, 3, label_type + "Comp)", text_color = color.white)
    table.cell(info_table, 1, 3, str.tostring(s_comp * 100, "##.#") + "%", text_color = s_comp > stability_thr ? color.blue : color.white)
    table.cell(info_table, 0, 4, label_type + "Exh)", text_color = color.white)
    table.cell(info_table, 1, 4, str.tostring(s_exh * 100, "##.#") + "%", text_color = s_exh > stability_thr ? color.orange : color.white)
    table.cell(info_table, 0, 5, label_type + "Chaos)", text_color = color.white)
    table.cell(info_table, 1, 5, str.tostring(s_chaos * 100, "##.#") + "%", text_color = s_chaos > stability_thr ? color.purple : color.white)

    // Markov Prediction
    float sum_t = 0.0
    for i = 0 to 4
        sum_t += array.get(transitions, regime * 5 + i)
    sum_t := math.max(sum_t, 1)

    // Find most likely next (excluding current)
    float m1 = -1.0, float m2 = -1.0
    int r1 = -1, int r2 = -1
    for i = 0 to 4
        if i == regime
            continue
        val = array.get(transitions, regime * 5 + i)
        if val > m1
            m2 := m1, r2 := r1
            m1 := val, r1 := i
        else if val > m2
            m2 := val, r2 := i

    table.cell(info_table, 0, 6, "Next Likely #1", text_color = color.white, text_size = size.small)
    table.cell(info_table, 1, 6, (r1 == -1 ? "N/A" : get_name(r1)) + " (" + str.tostring((m1 / sum_t) * 100, "##") + "%)", text_color = color.yellow, text_size = size.small)
    table.cell(info_table, 0, 7, "Next Likely #2", text_color = color.white, text_size = size.small)
    table.cell(info_table, 1, 7, (r2 == -1 ? "N/A" : get_name(r2)) + " (" + str.tostring((m2 / sum_t) * 100, "##") + "%)", text_color = color.gray, text_size = size.small)

// Plots
plotshape(buy_signal, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sell_signal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")
plotshape(exit_long or exit_short, title="EXIT", style=shape.xcross, location=location.abovebar, color=color.white, size=size.tiny, text="EXIT")

plotchar(warn_decel, title="Deceleration", char="!", location=location.abovebar, color=color.yellow, size=size.tiny)
plotchar(risk_reversal, title="Reversal Risk", char="‼", location=location.abovebar, color=color.red, size=size.small)
plotchar(divergence_top or divergence_bot, title="Energy Divergence", char="D", location=location.abovebar, color=color.fuchsia, size=size.tiny)
plotchar(breakout_setup, title="Breakout Potential", char="⊙", location=location.belowbar, color=color.aqua, size=size.tiny)

// Alerts
alertcondition(buy_signal, "Buy Signal", "MPRM: Bull Trend Detected")
alertcondition(sell_signal, "Sell Signal", "MPRM: Bear Trend Detected")
alertcondition(risk_reversal, "Reversal Risk", "MPRM: High Reversal Risk")
