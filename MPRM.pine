//@version=5
indicator("Market Physics Regime Model V2 (MPRM System)", overlay=true, max_labels_count=500)

// ==========================================
// 1. Inputs
// ==========================================
lookback_c      = input.int(20, "Coherence Lookback", minval=2)
lookback_std    = input.int(20, "Volatility Lookback", minval=2)
lookback_norm   = input.int(100, "Normalization Lookback", minval=10)
tau             = input.int(10, "Inertia EMA Period (τ)", minval=1)
stability_thr   = input.float(0.4, "Stability Threshold (0-1)", minval=0.1, maxval=1.0, step=0.05, tooltip="Minimum probability/score to switch regime")
table_transp    = input.int(40, "Table Transparency", minval=0, maxval=100)
use_softmax     = input.bool(true, "Use Softmax Probabilities for Decision")

// ==========================================
// 2. Fundamental Physics & Projected Vector
// ==========================================
// v_t: velocity (displacement)
v = close - close[1]

// a_t: acceleration
a = v - v[1]

// j_t: jerk
j = a - a[1]

// Projected Velocity (Newtonian approximation)
v_proj = v + a

// Efficiency (η) = Displacement / Total Path
path = math.sum(math.abs(v), lookback_c)
displacement = math.abs(close - close[lookback_c])
efficiency = displacement / math.max(path, 1e-10)

// ==========================================
// 3. Energy Metrics
// ==========================================
ek = math.pow(v, 2)
volatility = ta.stdev(close, lookback_std)
m = volatility * math.abs(v)
inertia = ta.ema(m, tau)
coherence = math.abs(ta.correlation(close, bar_index, lookback_c))
phi = coherence * (ek + inertia)
ep = ta.ema(1 / math.max(volatility, 1e-10) * coherence, tau)

// ==========================================
// 4. Normalization (Z-Score / Logits)
// ==========================================
get_z(src, len) =>
    mean = ta.sma(src, len)
    stdev = ta.stdev(src, len)
    (src - mean) / math.max(stdev, 1e-10)

sigmoid(x) => 1 / (1 + math.exp(-x))

// ==========================================
// 5. Regime Fields (Raw Z-Scores)
// ==========================================
f_confirm = (v > 0 and a > 0) or (v < 0 and a < 0) ? 1.0 : -0.5
z_trend = get_z(phi * efficiency * f_confirm, lookback_norm)

z_comp = get_z(ep * (1 - efficiency), lookback_norm)

exh_raw = (math.abs(j) / math.max(math.abs(a), 1e-10)) * coherence
z_exh = get_z(exh_raw, lookback_norm)

chaos_raw = (1 - coherence) * (1 - efficiency) * (ta.stdev(v, lookback_std))
z_chaos = get_z(chaos_raw, lookback_norm)

// ==========================================
// 6. Decision Logic
// ==========================================
float p_trend = 0.0, float p_comp = 0.0, float p_exh = 0.0, float p_chaos = 0.0
float score_trend = 0.0, float score_comp = 0.0, float score_exh = 0.0, float score_chaos = 0.0

if use_softmax
    exp_sum = math.exp(z_trend) + math.exp(z_comp) + math.exp(z_exh) + math.exp(z_chaos)
    p_trend := math.exp(z_trend) / exp_sum
    p_comp  := math.exp(z_comp) / exp_sum
    p_exh   := math.exp(z_exh) / exp_sum
    p_chaos := math.exp(z_chaos) / exp_sum
    score_trend := p_trend, score_comp := p_comp, score_exh := p_exh, score_chaos := p_chaos
else
    score_trend := sigmoid(z_trend), score_comp := sigmoid(z_comp), score_exh := sigmoid(z_exh), score_chaos := sigmoid(z_chaos)

float max_score = math.max(score_trend, score_comp, score_exh, score_chaos)
int raw_regime = 0
if max_score == score_trend
    raw_regime := 0
else if max_score == score_comp
    raw_regime := 1
else if max_score == score_exh
    raw_regime := 2
else
    raw_regime := 3

var int regime = 3
if max_score > stability_thr
    regime := raw_regime

// ==========================================
// 7. Anticipatory Warnings
// ==========================================
bool warn_decel = regime == 0 and ((v > 0 and a < 0) or (v < 0 and a > 0))
bool risk_reversal = (regime == 0 or regime == 2) and (z_exh > 1.5 or (warn_decel and z_exh > 0))
bool breakout_potential = (regime == 1 or regime == 3) and efficiency > 0.6 and phi > ta.sma(phi, lookback_norm)

// ==========================================
// 8. Visual System
// ==========================================
color c_trend = color.new(color.green, 85)
color c_comp  = color.new(color.blue, 85)
color c_exh   = color.new(color.orange, 85)
color c_chaos = color.new(color.purple, 85)

color regime_color = regime == 0 ? c_trend :
                     regime == 1 ? c_comp :
                     regime == 2 ? c_exh :
                     c_chaos

bgcolor(regime_color)
barcolor(regime == 0 ? color.green : regime == 1 ? color.blue : regime == 2 ? color.orange : regime == 3 ? color.purple : color.gray)

// Dashboard
var table info_table = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, table_transp), border_width = 1, border_color = color.gray)
if barstate.islast
    table.cell(info_table, 0, 0, "Regime", text_color = color.white)
    table.cell(info_table, 1, 0, regime == 0 ? "TREND" : regime == 1 ? "COMPRESSION" : regime == 2 ? "EXHAUSTION" : "CHAOS", text_color = color.white, bgcolor = regime_color)

    label_type = use_softmax ? "P(" : "S("
    table.cell(info_table, 0, 1, label_type + "Trend)", text_color = color.white)
    table.cell(info_table, 1, 1, str.tostring(score_trend * (use_softmax ? 100 : 1), use_softmax ? "##.#%" : "#.##"), text_color = score_trend > stability_thr ? color.green : color.white)

    table.cell(info_table, 0, 2, label_type + "Comp)", text_color = color.white)
    table.cell(info_table, 1, 2, str.tostring(score_comp * (use_softmax ? 100 : 1), use_softmax ? "##.#%" : "#.##"), text_color = score_comp > stability_thr ? color.blue : color.white)

    table.cell(info_table, 0, 3, label_type + "Exh)", text_color = color.white)
    table.cell(info_table, 1, 3, str.tostring(score_exh * (use_softmax ? 100 : 1), use_softmax ? "##.#%" : "#.##"), text_color = score_exh > stability_thr ? color.orange : color.white)

    table.cell(info_table, 0, 4, label_type + "Chaos)", text_color = color.white)
    table.cell(info_table, 1, 4, str.tostring(score_chaos * (use_softmax ? 100 : 1), use_softmax ? "##.#%" : "#.##"), text_color = score_chaos > stability_thr ? color.purple : color.white)

    table.cell(info_table, 0, 5, "Efficiency (η)", text_color = color.white)
    table.cell(info_table, 1, 5, str.tostring(efficiency, "#.##"), text_color = color.white)

    table.cell(info_table, 0, 6, "Proj. Move", text_color = color.white)
    table.cell(info_table, 1, 6, str.tostring(v_proj, "#.####"), text_color = v_proj > 0 ? color.green : color.red)

// Signals
plotshape(regime == 0 and regime[1] != 0, title="Enter Trend", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="TREND")
plotshape(regime == 2 and regime[1] != 2, title="Exhaustion", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="EXH")
plotshape(regime == 3 and regime[1] != 3, title="Chaos", style=shape.xcross, location=location.abovebar, color=color.purple, size=size.tiny, text="CHAOS")
plotchar(warn_decel, title="Deceleration", char="!", location=location.abovebar, color=color.yellow, size=size.tiny)
plotchar(risk_reversal, title="Reversal Risk", char="‼", location=location.abovebar, color=color.red, size=size.small)
plotchar(breakout_potential, title="Breakout Potential", char="⊙", location=location.belowbar, color=color.aqua, size=size.tiny)

// Alerts
alertcondition(regime != regime[1], "Regime Change", "Regime shifted")
alertcondition(risk_reversal, "Reversal Risk!", "Model detects high reversal risk")
alertcondition(breakout_potential, "Breakout Potential", "Model detects accumulation/breakout setup")
