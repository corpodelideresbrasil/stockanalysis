//@version=6
indicator("MPE Vector NOW - Full Trail & HUD", shorttitle="MPE Full", overlay=true)

// --- 0. CONFIGURAÇÕES E INPUTS ---
enum AssetProfile
    CRYPTO
    EQUITIES
    INDICES

AssetProfile profile = input.enum(AssetProfile.CRYPTO, "Perfil do Ativo", tooltip="Ajusta a sensibilidade da inércia com base na 'viscosidade' do mercado.")

float markov_decay = switch profile
    AssetProfile.CRYPTO  => 0.85
    AssetProfile.EQUITIES => 0.95
    AssetProfile.INDICES  => 0.98

// --- 0.1 MÉTRICA DE PERSISTÊNCIA (HURST INSTANTÂNEO) ---
// Removida a média móvel (EMA) para eliminar lag. Hurst agora é calculado sobre 20 períodos para maior reatividades.
get_hurst(len) =>
    float log_len = math.log(len)
    float max_high = ta.highest(high, len)
    float min_low = ta.lowest(low, len)
    float r = max_high - min_low
    float s = ta.stdev(close, len)
    float h = s != 0 ? math.log(r / s) / log_len : 0.5
    h

float h_val = get_hurst(20)

string h_state = h_val > 0.55 ? "Trending" : h_val < 0.45 ? "Mean-Rev" : "Random"
color h_color = h_val > 0.55 ? color.aqua : h_val < 0.45 ? color.fuchsia : color.gray

// --- 1. MÓDULO DE FÍSICA ---
float body_work = math.abs(close - open)
float f_bull    = close > open ? body_work : 0.0
float f_bear    = close < open ? body_work : 0.0
float f_comp    = math.max(0.0, (nz(high[1] - low[1], high - low) - (high - low)))
float f_exh     = math.max(high - math.max(open, close), math.min(open, close) - low) > (body_work * 1.2) ? math.max(high - math.max(open, close), math.min(open, close) - low) : 0.0

float total = f_bull + f_bear + f_comp + f_exh
float p_bull_i = f_bull / (total == 0 ? 1 : total)
float p_bear_i = f_bear / (total == 0 ? 1 : total)
float p_comp_i = f_comp / (total == 0 ? 1 : total)
float p_exh_i  = f_exh  / (total == 0 ? 1 : total)

// --- 2. CADEIA DE MARKOV (INÉRCIA) ---
var float p_bull = 0.25, var float p_bear = 0.25, var float p_comp = 0.25, var float p_exh = 0.25
p_bull := (p_bull * markov_decay) + (p_bull_i * (1 - markov_decay))
p_bear := (p_bear * markov_decay) + (p_bear_i * (1 - markov_decay))
p_comp := (p_comp * markov_decay) + (p_comp_i * (1 - markov_decay))
p_exh  := (p_exh * markov_decay)  + (p_exh_i * (1 - markov_decay))

// --- 3. INERTIAL TRAIL & POSITION TRACKING ---
float max_p = math.max(p_bull, p_bear, p_comp, p_exh)
int regime = max_p == p_bull ? 0 : max_p == p_bear ? 1 : max_p == p_comp ? 2 : 3
color regime_col = regime == 0 ? color.green : regime == 1 ? color.red : regime == 2 ? color.blue : color.orange

// Variáveis de Estado da Posição
var int pos_state = 0 // 0: Fora, 1: Comprado, -1: Vendido
var float trail_sl = na

// Cálculo de Distância Baseado na Força (Energia Instantânea)
// Substituído ATR por uma métrica de 'Trabalho de Preço' (Volatilidade Real do Momento)
float work_dist = total * 1.5

// Lógica de Entrada (Só permite nova ordem se pos_state == 0)
if pos_state == 0
    if regime == 0 // Bull (Trend Following)
        pos_state := 1
        trail_sl := low - work_dist
    else if regime == 1 // Bear (Trend Following)
        pos_state := -1
        trail_sl := high + work_dist

// Lógica de Manutenção e Saída
bool exit_long  = false
bool exit_short = false

if pos_state == 1 // Long
    // Ajuste dinâmico: usa as energias atuais para apertar o stop
    // Se houver compressão ou exaustão, o stop sobe agressivamente.
    float current_dist = (regime == 3 or regime == 2) ? total * 0.5 : total * 1.2
    float current_sl = low - current_dist
    trail_sl := na(trail_sl) ? current_sl : math.max(trail_sl, current_sl)

    // Saída por Preço ou Regime (Markov Flip)
    if close < trail_sl or regime == 1
        exit_long := true
        pos_state := 0
        trail_sl := na
else if pos_state == -1 // Short
    float current_dist = (regime == 3 or regime == 2) ? total * 0.5 : total * 1.2
    float current_sl = high + current_dist
    trail_sl := na(trail_sl) ? current_sl : math.min(trail_sl, current_sl)

    if close > trail_sl or regime == 0
        exit_short := true
        pos_state := 0
        trail_sl := na

// Plotagem da Inércia (Inertial Trail / Stop Loss)
plot(trail_sl, "Inertial Trail SL", color=regime_col, linewidth=2, style=plot.style_linebr)

// Coloração dos Candles por Estado de Markov (Visão Direta do Regime)
// As cores tradicionais (verde/vermelho) agora representam o Estado de Markov, não o fechamento do candle.
barcolor(regime_col)

// --- 3.1 SINAIS DE EXECUÇÃO (IGNITION & FORCE BREAK) ---
bool enter_long  = pos_state == 1 and pos_state[1] == 0
bool enter_short = pos_state == -1 and pos_state[1] == 0

// Ignição de Movimento (Entrada) - Círculos com ícones de energia
plotshape(enter_long, "IGNITION LONG", shape.circle, location.belowbar, color.green, size=size.small, text="⚡", textcolor=color.white)
plotshape(enter_short, "IGNITION SHORT", shape.circle, location.abovebar, color.red, size=size.small, text="🔥", textcolor=color.white)

// Convicção (Hurst Persistence)
plotshape(enter_long and h_val > 0.55, "HIGH PERSISTENCE", shape.labelup, location.belowbar, color.new(color.green, 100), text="🚀", textcolor=color.green, size=size.tiny)
plotshape(enter_short and h_val > 0.55, "HIGH PERSISTENCE", shape.labeldown, location.abovebar, color.new(color.red, 100), text="🚀", textcolor=color.red, size=size.tiny)

// Quebra de Força (Saída) - Símbolo de "Power Off"
plotshape(exit_long, "FORCE BREAK LONG", shape.labeldown, location.abovebar, color.new(color.black, 40), text="⭕", textcolor=color.red, size=size.small)
plotshape(exit_short, "FORCE BREAK SHORT", shape.labelup, location.belowbar, color.new(color.black, 40), text="⭕", textcolor=color.green, size=size.small)

// --- 4. ENGINE GAUGE (BALANÇO DE FORÇAS EM TEMPO REAL) ---
// Visualização vertical no canto direito para mostrar o jogo de forças ATUAL.
var table gauge = table.new(position.middle_right, 2, 4, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if barstate.islast
    // Força Bull vs Bear
    table.cell(gauge, 0, 0, "⚡ BULL", text_color=color.green, text_size=size.small)
    table.cell(gauge, 1, 0, str.tostring(p_bull_i * 100, "0") + "%", text_color=color.white, text_size=size.small)

    table.cell(gauge, 0, 1, "🔥 BEAR", text_color=color.red, text_size=size.small)
    table.cell(gauge, 1, 1, str.tostring(p_bear_i * 100, "0") + "%", text_color=color.white, text_size=size.small)

    table.cell(gauge, 0, 2, "🌀 COMP", text_color=color.blue, text_size=size.small)
    table.cell(gauge, 1, 2, str.tostring(p_comp_i * 100, "0") + "%", text_color=color.white, text_size=size.small)

    table.cell(gauge, 0, 3, "💨 EXH", text_color=color.orange, text_size=size.small)
    table.cell(gauge, 1, 3, str.tostring(p_exh_i * 100, "0") + "%", text_color=color.white, text_size=size.small)

// --- 5. TABELA HUD (SYSTEM STATUS) ---
var table hud = table.new(position.top_right, 4, 1, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if barstate.islast
    string regime_str = regime == 0 ? "BULLISH" : regime == 1 ? "BEARISH" : regime == 2 ? "COMPRESSION" : "EXHAUSTION"
    string system_str = pos_state == 1 ? "LONG" : pos_state == -1 ? "SHORT" : "WAITING"
    color system_col = pos_state == 0 ? color.gray : color.lime

    table.cell(hud, 0, 0, "SYSTEM: " + system_str, text_color=system_col, text_size=size.small)
    table.cell(hud, 1, 0, "REGIME: " + regime_str, text_color=regime_col, text_size=size.small)
    table.cell(hud, 2, 0, "HURST: " + str.tostring(h_val, "#.##"), text_color=h_color, text_size=size.small)
    table.cell(hud, 3, 0, "STATE: " + h_state, text_color=h_color, text_size=size.small)

// --- 6. ALERTAS OPERACIONAIS ---
alertcondition(enter_long, "Ignição de Compra (BULL)", "Motor BULL ligado. Considere entrada de compra.")
alertcondition(enter_short, "Ignição de Venda (BEAR)", "Motor BEAR ligado. Considere entrada de venda.")
alertcondition(exit_long or exit_short, "Quebra de Força (EXIT)", "A energia do movimento acabou. Considere fechar a posição.")
