//@version=6
indicator("MPE Vector NOW - Full Trail & HUD", shorttitle="MPE Full", overlay=true)

// --- 1. MÓDULO DE FÍSICA ---
float body_work = math.abs(close - open)
float f_bull    = close > open ? body_work : 0.0
float f_bear    = close < open ? body_work : 0.0
float f_comp    = math.max(0.0, (nz(high[1] - low[1], high - low) - (high - low)))
float f_exh     = math.max(high - math.max(open, close), math.min(open, close) - low) > (body_work * 1.2) ? math.max(high - math.max(open, close), math.min(open, close) - low) : 0.0

float total = f_bull + f_bear + f_comp + f_exh
float p_bull_i = f_bull / (total == 0 ? 1 : total)
float p_bear_i = f_bear / (total == 0 ? 1 : total)
float p_comp_i = f_comp / (total == 0 ? 1 : total)
float p_exh_i  = f_exh  / (total == 0 ? 1 : total)

// --- 2. CADEIA DE MARKOV (INÉRCIA) ---
var float p_bull = 0.25, var float p_bear = 0.25, var float p_comp = 0.25, var float p_exh = 0.25
p_bull := (p_bull * 0.75) + (p_bull_i * 0.25)
p_bear := (p_bear * 0.75) + (p_bear_i * 0.25)
p_comp := (p_comp * 0.75) + (p_comp_i * 0.25)
p_exh  := (p_exh * 0.75)  + (p_exh_i * 0.25)

// --- 3. INERTIAL TRAIL (REGIME VISUAL) ---
float max_p = math.max(p_bull, p_bear, p_comp, p_exh)
int regime = max_p == p_bull ? 0 : max_p == p_bear ? 1 : max_p == p_comp ? 2 : 3
color regime_col = regime == 0 ? color.green : regime == 1 ? color.red : regime == 2 ? color.blue : color.orange

// Plotagem da Inércia (Inertial Trail)
plot(close, "Inertial Trail", color=regime_col, linewidth=3, style=plot.style_line)
barcolor(color.new(regime_col, 50))

// --- 4. TABELA HUD ---
var table hud = table.new(position.top_right, 3, 5, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

if barstate.islast
    table.cell(hud, 0, 0, "Força", text_color=color.white)
    table.cell(hud, 1, 0, "Agora", text_color=color.white)
    table.cell(hud, 2, 0, "Markov", text_color=color.white)

    table.cell(hud, 0, 1, "Bull", text_color=color.green)
    table.cell(hud, 1, 1, str.tostring(p_bull_i * 100, "#.0") + "%", text_color=color.white)
    table.cell(hud, 2, 1, str.tostring(p_bull * 100, "#.0") + "%", text_color=color.white)

    table.cell(hud, 0, 2, "Bear", text_color=color.red)
    table.cell(hud, 1, 2, str.tostring(p_bear_i * 100, "#.0") + "%", text_color=color.white)
    table.cell(hud, 2, 2, str.tostring(p_bear * 100, "#.0") + "%", text_color=color.white)

    table.cell(hud, 0, 3, "Comp", text_color=color.blue)
    table.cell(hud, 1, 3, str.tostring(p_comp_i * 100, "#.0") + "%", text_color=color.white)
    table.cell(hud, 2, 3, str.tostring(p_comp * 100, "#.0") + "%", text_color=color.white)

    table.cell(hud, 0, 4, "Exh", text_color=color.orange)
    table.cell(hud, 1, 4, str.tostring(p_exh_i * 100, "#.0") + "%", text_color=color.white)
    table.cell(hud, 2, 4, str.tostring(p_exh * 100, "#.0") + "%", text_color=color.white)
